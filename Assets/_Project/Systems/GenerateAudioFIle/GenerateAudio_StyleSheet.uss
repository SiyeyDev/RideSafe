Slider #unity-tracker {
    background-color: rgb(1, 103, 101);
    border-left-color: rgba(17, 49, 49, 0);
    border-right-color: rgba(17, 49, 49, 0);
    border-top-color: rgba(17, 49, 49, 0);
    border-bottom-color: rgba(17, 49, 49, 0);
    border-top-left-radius: 7%;
    border-top-right-radius: 7%;
    border-bottom-right-radius: 7%;
    border-bottom-left-radius: 7%;
}

Slider #unity-text-input {
    background-color: rgb(5, 51, 51);
    -unity-background-image-tint-color: rgb(0, 250, 255);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-right: 0;
    padding-left: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
}

Slider #unity-drag-container {
    width: auto;
    background-color: rgba(255, 0, 0, 0);
}

Slider #unity-dragger {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgb(0, 255, 223);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

Slider Label {
    width: 45%;
    min-width: 0;
    font-size: 12px;
}

Toggle #unity-checkmark {
    background-color: rgb(0, 250, 255);
    text-overflow: clip;
    border-top-left-radius: 48%;
    border-top-right-radius: 48%;
    border-bottom-right-radius: 48%;
    border-bottom-left-radius: 48%;
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    border-left-color: rgb(0, 255, 238);
    border-right-color: rgb(0, 255, 238);
    border-top-color: rgb(0, 255, 238);
    border-bottom-color: rgb(0, 255, 238);
    -unity-slice-scale: -1px;
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
    -unity-background-image-tint-color: rgba(1, 5, 5, 0.7);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ElevebLabdsSubText {
    color: rgb(124, 255, 237);
    font-size: 12px;
    -unity-font-style: bold;
}

.ElevenLabsText {
    color: rgb(0, 255, 223);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
}

Button {
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 15;
    -unity-slice-top: 5;
    -unity-slice-right: 15;
    -unity-slice-bottom: 5;
}

.LocalizeSubText {
    color: rgb(250, 255, 124);
    font-size: 12px;
    -unity-font-style: bold;
}

.LocalizeText {
    color: rgb(253, 255, 0);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    -unity-background-image-tint-color: rgb(253, 255, 0);
    background-color: rgb(46, 49, 17);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    border-left-color: rgb(255, 226, 0);
    border-right-color: rgb(255, 226, 0);
    border-top-color: rgb(255, 226, 0);
    border-bottom-color: rgb(255, 226, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

DropdownField .unity-base-field_input {
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    background-color: rgb(19, 52, 52);
    -unity-background-image-tint-color: rgb(0, 255, 223);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 9;
    -unity-slice-top: 9;
    -unity-slice-right: 9;
    -unity-slice-bottom: 9;
}

#VoiceDropField .unity-base-popup-field__arrow {
    background-color: rgba(0, 255, 222, 0);
    -unity-background-image-tint-color: rgb(0, 255, 222);
    background-image: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=8300712400058098730&guid=1ecff3374ede0df4c88c26e7a0f08ba3&type=3#dropdown-arrow@2x');
}

#VoiceDropField .unity-base-popup-field__input {
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    -unity-background-image-tint-color: rgb(0, 255, 242);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 46;
    -unity-slice-top: 46;
    -unity-slice-right: 46;
    -unity-slice-bottom: 46;
    background-color: rgb(7, 55, 52);
}

#VoiceDropField .unity-base-popup-field__text {
    -unity-background-image-tint-color: rgb(0, 108, 101);
    background-color: rgba(2, 103, 102, 0);
}

.unity-base-popup-field__arrow {
    background-color: rgba(0, 255, 222, 0);
    -unity-background-image-tint-color: rgb(255, 255, 0);
    background-image: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=8300712400058098730&guid=1ecff3374ede0df4c88c26e7a0f08ba3&type=3#dropdown-arrow@2x');
}

.unity-base-popup-field__input {
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    -unity-background-image-tint-color: rgb(253, 255, 0);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 46;
    -unity-slice-top: 46;
    -unity-slice-right: 46;
    -unity-slice-bottom: 46;
    background-color: rgb(53, 55, 7);
}

.unity-enum-field__arrow {
    background-color: rgba(0, 255, 222, 0);
    -unity-background-image-tint-color: rgb(255, 255, 0);
    background-image: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=8300712400058098730&guid=1ecff3374ede0df4c88c26e7a0f08ba3&type=3#dropdown-arrow@2x');
}

.unity-enum-field__input {
    background-image: url("project://database/Assets/UIToolkit/RadialGradien_256x256.png?fileID=2800000&guid=a73ff8472bd40b94c8f3e7520a502e0f&type=3#RadialGradien_256x256");
    -unity-background-image-tint-color: rgb(253, 255, 0);
    -unity-slice-scale: 0.1px;
    -unity-slice-left: 46;
    -unity-slice-top: 46;
    -unity-slice-right: 46;
    -unity-slice-bottom: 46;
    background-color: rgb(53, 55, 7);
}

#Avoid .slide-toggle__input {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(255, 0, 0);
    align-self: center;
    justify-content: flex-start;
    flex-direction: column;
}

#Avoid .unity-text-element {
    color: rgb(255, 255, 255);
}

#Avoid .slide-toggle__input-knob {
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(217, 217, 217);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    align-self: stretch;
    align-items: stretch;
    justify-content: space-around;
    flex-grow: 0;
    flex-shrink: 0;
    flex-wrap: nowrap;
    flex-direction: row;
    top: -2%;
}

#Avoid .slide-toggle__input--checked {
    background-color: rgb(29, 255, 0);
    align-items: center;
    justify-content: center;
    align-self: center;
}

#TestContainer {
    color: rgb(196, 236, 255);
}
