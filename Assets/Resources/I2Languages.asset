      Languages:
      - A helmet that has already been hit will not absorb the next one.
      - "Un casco que ya recibi\xF3 un golpe no absorbe el siguiente."
      Flags: 0000
      Languages_Touch: []
    - Term: M1/Item_HelmetOk_Risk
      TermType: 0
