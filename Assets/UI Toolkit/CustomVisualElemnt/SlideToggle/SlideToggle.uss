.slide-toggle__input {
    background-color: rgb(0, 73, 84);
    max-width: 28px;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: visible;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(0, 255, 217);
    border-top-color: rgb(0, 255, 217);
    border-bottom-color: rgb(0, 255, 217);
    max-height: none;
    margin-top: 0;
    border-left-color: rgb(0, 255, 217);
    transition-property: background-color;
    transition-duration: 0.5s;
    align-self: center;
    min-width: 25px;
    min-height: 0;
    align-items: center;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    width: 36px;
    height: 18px;
    top: auto;
}

.slide-toggle__input-knob {
    height: 18px;
    width: 18px;
    background-color: rgb(8, 164, 149);
    position: absolute;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    top: auto;
    transition-property: translate, background-color;
    transition-duration: 0.5s, 0.5s;
    translate: -1px 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 255, 242);
    border-right-color: rgb(0, 255, 242);
    border-top-color: rgb(0, 255, 242);
    border-bottom-color: rgb(0, 255, 242);
    -unity-background-image-tint-color: rgb(0, 132, 119);
    flex-shrink: 0;
    align-items: center;
    align-self: center;
    justify-content: center;
}

.slide-toggle__input--checked {
    background-color: rgb(0, 156, 10);
}

.slide-toggle__input--checked > .slide-toggle__input-knob {
    translate: 9px 0;
}

SlideToggle .unity-text-element {
    -unity-text-align: middle-center;
    align-items: center;
    align-self: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 12px;
    padding-left: 4px;
    max-width: none;
    white-space: nowrap;
    min-width: 0;
    margin-right: 8px;
    margin-left: 8px;
    padding-right: 4px;
}
